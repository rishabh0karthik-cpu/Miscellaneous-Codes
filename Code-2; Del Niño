"""Legacy compatibility module for the validated current-forecast pipeline."""

import numpy as np

try:
    from testing.quadratic_current_model import QuadraticCurrentPredictor
except ModuleNotFoundError:
    from importlib.util import module_from_spec, spec_from_file_location
    from pathlib import Path

    _MODEL_PATH = Path(__file__).resolve().parent / "testing" / "quadratic_current_model.py"
    _MODEL_SPEC = spec_from_file_location("quadratic_current_model", _MODEL_PATH)
    if _MODEL_SPEC is None or _MODEL_SPEC.loader is None:
        raise ImportError("could not load the canonical quadratic current model")
    _MODEL_MODULE = module_from_spec(_MODEL_SPEC)
    _MODEL_SPEC.loader.exec_module(_MODEL_MODULE)
    QuadraticCurrentPredictor = _MODEL_MODULE.QuadraticCurrentPredictor


class OceanCurrentPredictor:
    def __init__(self):
        self.model = QuadraticCurrentPredictor()

    def fit(self, feature_data, current_patterns):
        self.model.fit(feature_data, current_patterns)
        return self

    def predict(self, feature_data):
        return self.model.predict(feature_data)


class LinearCurrentDynamics:
    """Learn a linear transition matrix for consecutive current patterns."""

    def __init__(self):
        self.transition_matrix = None
        self.residual_covariance = None

    def fit(self, current_patterns):
        current_patterns = np.asarray(current_patterns, dtype=float)
        if current_patterns.ndim != 2 or current_patterns.shape[0] < 2:
            raise ValueError("current_patterns must contain at least two observations")
        if current_patterns.shape[1] == 0 or not np.isfinite(current_patterns).all():
            raise ValueError("current_patterns must be non-empty and finite")

        previous_patterns = current_patterns[:-1]
        next_patterns = current_patterns[1:]
        self.transition_matrix, _, _, _ = np.linalg.lstsq(
            previous_patterns, next_patterns, rcond=None
        )

        residuals = next_patterns - previous_patterns @ self.transition_matrix
        self.residual_covariance = np.atleast_2d(np.cov(residuals, rowvar=False))
        return self

    def predict_next(self, current_pattern):
        if self.transition_matrix is None:
            raise RuntimeError("fit must be called before predict_next")
        current_pattern = np.asarray(current_pattern, dtype=float)
        if current_pattern.ndim != 1 or current_pattern.shape[0] != self.transition_matrix.shape[0]:
            raise ValueError("current_pattern must match the fitted feature dimension")
        if not np.isfinite(current_pattern).all():
            raise ValueError("current_pattern must contain only finite values")
        return current_pattern @ self.transition_matrix

    def predict_sequence(self, initial_pattern, steps):
        if steps < 1:
            raise ValueError("steps must be positive")
        predictions = []
        current_pattern = np.asarray(initial_pattern, dtype=float)
        for _ in range(steps):
            current_pattern = self.predict_next(current_pattern)
            predictions.append(current_pattern)
        return np.asarray(predictions)


def plot_current_paths(
    initial_positions,
    velocity_forecast,
    save_path=None,
    time_step_seconds=30 * 24 * 60 * 60,
):
    """Plot predicted ocean-current paths from longitude/latitude seed points.

    ``initial_positions`` has shape ``(locations, 2)`` and stores longitude,
    latitude pairs. ``velocity_forecast`` has shape ``(steps, locations, 2)``
    and stores eastward and northward velocities in m/s. ``time_step_seconds`` converts
    velocity into geographic displacement for plotting.
    """
    import matplotlib.pyplot as plt

    initial_positions = np.asarray(initial_positions, dtype=float)
    velocity_forecast = np.asarray(velocity_forecast, dtype=float)
    if initial_positions.ndim != 2 or initial_positions.shape[1] != 2:
        raise ValueError("initial_positions must have shape (locations, 2)")
    if velocity_forecast.ndim != 3 or velocity_forecast.shape[2] != 2:
        raise ValueError("velocity_forecast must have shape (steps, locations, 2)")
    if velocity_forecast.shape[1] != initial_positions.shape[0]:
        raise ValueError("forecast locations must match initial_positions")
    if time_step_seconds <= 0 or not np.isfinite(time_step_seconds):
        raise ValueError("time_step_seconds must be positive and finite")
    if np.any(np.abs(initial_positions[:, 1]) >= 90):
        raise ValueError("initial latitudes must be strictly between -90 and 90 degrees")

    meters_per_degree_latitude = 111_320.0
    latitude_radians = np.deg2rad(initial_positions[:, 1])
    longitude_scale = meters_per_degree_latitude * np.cos(latitude_radians)
    displacement = velocity_forecast.transpose(1, 0, 2) * time_step_seconds
    displacement[:, :, 0] /= longitude_scale[:, None]
    displacement[:, :, 1] /= meters_per_degree_latitude
    paths = np.empty((velocity_forecast.shape[1], velocity_forecast.shape[0] + 1, 2))
    paths[:, 0] = initial_positions
    paths[:, 1:] = initial_positions[:, None, :] + np.cumsum(displacement, axis=1)
    paths[:, :, 0] = ((paths[:, :, 0] + 180) % 360) - 180
    paths[:, :, 1] = np.clip(paths[:, :, 1], -90, 90)

    figure, axes = plt.subplots(figsize=(13, 7))
    try:
        from importlib import import_module

        ccrs = import_module("cartopy.crs")

        plt.close(figure)
        figure = plt.figure(figsize=(13, 7))
        axes = figure.add_subplot(1, 1, 1, projection=ccrs.PlateCarree())
        axes.set_global()
        axes.coastlines()
        axes.gridlines(draw_labels=True, linewidth=0.4, alpha=0.5)
        transform = ccrs.PlateCarree()
    except ImportError:
        axes.set_xlim(-180, 180)
        axes.set_ylim(-90, 90)
        axes.set_xlabel("Longitude")
        axes.set_ylabel("Latitude")
        axes.set_facecolor("#eaf4f7")
        axes.grid(True, linewidth=0.4, alpha=0.5)
        transform = None

    for location_index, path in enumerate(paths):
        plot_kwargs = {"label": f"Current {location_index + 1}"}
        if transform is not None:
            plot_kwargs["transform"] = transform
        axes.plot(path[:, 0], path[:, 1], marker="o", markersize=3, **plot_kwargs)

    axes.set_title("Predicted Ocean-Current Paths")
    axes.legend(loc="upper right", fontsize="small", ncol=2)
    figure.tight_layout()
    if save_path is not None:
        figure.savefig(save_path, dpi=150, bbox_inches="tight")
    return figure, axes


def main() -> None:
    np.random.seed(42)
    X_train = np.random.rand(100, 30)
    y_train = np.random.rand(100, 10)

    predictor = OceanCurrentPredictor()
    predictor.fit(X_train, y_train)

    X_test = np.random.rand(1, 30)
    predicted_current = predictor.predict(X_test)[0]

    dynamics = LinearCurrentDynamics()
    dynamics.fit(y_train)
    forecast = dynamics.predict_sequence(predicted_current, steps=3)
    initial_positions = np.array([
        [-150, 0], [-90, 15], [-30, -10], [60, 5], [150, -15]
    ])
    velocity_forecast = forecast.reshape(forecast.shape[0], 5, 2)
    plot_current_paths(initial_positions, velocity_forecast, "current_forecast.png")

    print("Predicted Current Pattern:", predicted_current)
    print("Forecast Current Patterns:", forecast)
    print("Forecast Residual Covariance:", dynamics.residual_covariance)
    print("Saved current path plot: current_forecast.png")


if __name__ == "__main__":
    main()
