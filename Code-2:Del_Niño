"""Legacy compatibility demo for the del_nino package."""

from __future__ import annotations

import argparse
import sys
from pathlib import Path

import numpy as np

ROOT = Path(__file__).resolve().parent
SRC = ROOT / "src"

if SRC.is_dir() and str(SRC) not in sys.path:
    sys.path.insert(0, str(SRC))

from del_nino import LinearCurrentDynamics, OceanCurrentPredictor, __version__
from del_nino.io import load_array_fields
from del_nino.metrics import anomaly_correlation, rmse
from del_nino.plotting import plot_current_paths


def _synthetic_training_data(
    n_samples: int = 100,
    n_features: int = 30,
    n_outputs: int = 10,
    seed: int = 42,
) -> tuple[np.ndarray, np.ndarray]:
    rng = np.random.default_rng(seed)
    trend = np.linspace(0.0, 1.0, n_samples)[:, None]

    features = 0.3 * trend + rng.standard_normal(
        (n_samples, n_features)
    )

    loadings = rng.standard_normal(
        (n_features, n_outputs)
    ) * 0.1

    currents = features @ loadings
    currents += 0.2 * trend
    currents += 0.05 * rng.standard_normal(
        (n_samples, n_outputs)
    )

    return features, currents


def _parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Run the legacy del_nino demonstration."
    )

    parser.add_argument(
        "--output",
        type=Path,
        default=Path("current_forecast.png"),
        help="Path for the forecast plot.",
    )

    parser.add_argument(
        "--forecast-steps",
        type=int,
        default=3,
        help="Number of forecast steps.",
    )

    parser.add_argument(
        "--ensemble-size",
        type=int,
        default=50,
        help="Number of ensemble members.",
    )

    return parser.parse_args()


def main() -> None:
    args = _parse_args()

    if args.forecast_steps < 1:
        raise ValueError("--forecast-steps must be at least 1.")

    if args.ensemble_size < 1:
        raise ValueError("--ensemble-size must be at least 1.")

    print(f"del_nino v{__version__} — legacy demo entrypoint")

    features, currents = _synthetic_training_data()

    predictor = OceanCurrentPredictor()
    predictor.fit(features, currents)

    predicted_current = predictor.predict(features[:1])[0]

    dynamics = LinearCurrentDynamics()
    dynamics.fit(currents)

    result = dynamics.predict_sequence(
        predicted_current,
        steps=args.forecast_steps,
        return_covariance=True,
        ensemble_size=args.ensemble_size,
        rng=7,
    )

    forecast = result.forecast

    if result.covariance is None or result.ensemble is None:
        raise RuntimeError(
            "Prediction did not return covariance and ensemble data."
        )

    holdout_features = features[10:]
    holdout_observed = currents[10:]
    holdout_predicted = predictor.predict(holdout_features)

    rmse_score = rmse(
        holdout_predicted,
        holdout_observed,
    )
    acc_score = anomaly_correlation(
        holdout_predicted,
        holdout_observed,
    )

    lat = np.linspace(-40.0, 40.0, 8)
    lon = np.linspace(-180.0, 180.0, 16)
    time = np.arange(
        "2020-01-01",
        "2020-01-05",
        dtype="datetime64[D]",
    )

    rng = np.random.default_rng(0)

    sst = 15.0 + 10.0 * rng.random(
        (time.size, lat.size, lon.size)
    )

    fields = load_array_fields(
        {"sea_surface_temperature": sst},
        latitude=lat,
        longitude=lon,
        time=time,
        units="degrees_celsius",
    )

    X, mask = fields.feature_matrix()
    finite_ratio = mask.mean() if mask is not None else 1.0

    print(
        f"Loaded {len(fields.fields)} gridded field(s); "
        f"feature matrix shape = {X.shape}, "
        f"finite ratio = {finite_ratio:.2%}"
    )

    initial_positions = np.array(
        [
            [-150.0, 0.0],
            [-90.0, 15.0],
            [-30.0, -10.0],
            [60.0, 5.0],
            [150.0, -15.0],
        ]
    )

    locations = len(initial_positions)
    components = locations * 2

    if (
        forecast.ndim == 2
        and forecast.shape[0] >= args.forecast_steps
        and forecast.shape[1] >= components
    ):
        velocity_forecast = forecast[
            :args.forecast_steps,
            :components,
        ].reshape(
            args.forecast_steps,
            locations,
            2,
        )
    else:
        velocity_forecast = np.zeros(
            (args.forecast_steps, locations, 2)
        )

        velocity_forecast[:, :, 0] = (
            0.1
            * np.arange(
                1,
                args.forecast_steps + 1,
            )[:, None]
        )

        velocity_forecast[:, :, 1] = (
            0.05
            * np.cos(
                np.linspace(
                    -np.pi,
                    np.pi,
                    locations,
                )
            )
        )

    args.output.parent.mkdir(
        parents=True,
        exist_ok=True,
    )

    plot_current_paths(
        initial_positions,
        velocity_forecast,
        args.output,
    )

    final_covariance = result.covariance[-1]
    final_ensemble = result.ensemble[:, -1, :]
    ensemble_std = final_ensemble.std(axis=0)

    print("\nPredicted Current Pattern:")
    print(
        np.array2string(
            predicted_current,
            precision=4,
            separator=", ",
        )
    )

    print(
        f"\nForecast Current Patterns "
        f"(shape {forecast.shape}):"
    )
    print(
        np.array2string(
            forecast,
            precision=4,
            separator=", ",
        )
    )

    print(
        f"\nForecast Residual Covariance "
        f"(shape {dynamics.residual_covariance.shape}):"
    )
    print(
        np.array2string(
            dynamics.residual_covariance,
            precision=4,
        )
    )

    print(
        "\nForecast covariance diagonal:",
        np.diag(final_covariance).round(6),
    )

    print(
        "Ensemble spread at final step:",
        ensemble_std.round(6),
    )

    print(f"\nHoldout RMSE : {rmse_score}")
    print(f"Holdout ACC  : {acc_score}")
    print(f"Forecast steps: {args.forecast_steps}")
    print(f"Ensemble size: {args.ensemble_size}")
    print(f"Saved current path plot: {args.output.resolve()}")


if __name__ == "__main__":
    main()